{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appxx",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "26137217-69b4-4010-a62a-db9216ec7eaf","database_name": "web-bty" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e1bc4595e5fa4e4ea4f6354b0cc562a0" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
